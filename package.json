{
  "name": "typed-table",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:examples": "npm run build --workspace @typed-table/example-basic-table && npm run build --workspace @typed-table/example-filter-row-selection && npm run build --workspace @typed-table/example-remote-pagination && npm run build --workspace @typed-table/example-infinite-scroll",
    "bench:core": "vitest bench --config vitest.config.ts --environment node packages/core/test/pipeline.bench.ts",
    "changeset": "changeset",
    "dev:basic": "npm run dev --workspace @typed-table/example-basic-table",
    "dev:filter-selection": "npm run dev --workspace @typed-table/example-filter-row-selection",
    "dev:remote": "npm run dev --workspace @typed-table/example-remote-pagination",
    "dev:infinite-scroll": "npm run dev --workspace @typed-table/example-infinite-scroll",
    "release:version": "changeset version",
    "release:publish": "npm run build && changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
